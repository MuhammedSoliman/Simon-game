# Automatically normalize line endings for all text files on checkout
* text=auto

# Explicitly declare shell scripts as LF
gradlew text eol=lf

# Kotlin/Java/XML source files — normalize to LF in the repo
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Binary files — do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.aar binary
*.keystore binary
