<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <!-- Top space to push content down -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.5"/>

        <!-- Score and Mute Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score"
                android:textSize="28sp"
                android:textColor="@color/simon_gold"
                android:layout_centerHorizontal="true"
                android:fontFamily="monospace"/>

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mute_button_description"
                android:src="@drawable/ic_volume_up"/>
        </RelativeLayout>

        <!-- Game Board -->
        <RelativeLayout
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center">

            <Button
                android:id="@+id/greenButton"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/simon_button_green"
                android:contentDescription="@string/green_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/redButton"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/simon_button_red"
                android:contentDescription="@string/red_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/yellowButton"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/simon_button_yellow"
                android:contentDescription="@string/yellow_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/blueButton"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/simon_button_blue"
                android:contentDescription="@string/blue_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/startButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerInParent="true"
                android:background="@drawable/simon_center_button"
                android:text="@string/start_game"
                android:textColor="@color/simon_white"
                android:textSize="16sp"
                android:contentDescription="@string/start_button_description"
                android:textStyle="bold"/>
        </RelativeLayout>

        <!-- Bottom space for balance -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>