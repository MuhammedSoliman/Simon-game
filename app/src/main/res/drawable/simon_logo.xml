<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle border -->
    <item>
        <shape android:shape="oval">
            <size android:width="200dp" android:height="200dp"/>
            <solid android:color="@android:color/darker_gray"/>
        </shape>
    </item>
    
    <!-- Inner black background -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/black"/>
        </shape>
    </item>

    <!-- Green button (top-left) -->
    <item android:left="8dp" android:top="8dp" android:right="104dp" android:bottom="104dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="100dp"/>
            <solid android:color="#00FF00"/>
        </shape>
    </item>

    <!-- Red button (top-right) -->
    <item android:left="104dp" android:top="8dp" android:right="8dp" android:bottom="104dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="100dp"/>
            <solid android:color="#FF0000"/>
        </shape>
    </item>

    <!-- Yellow button (bottom-left) -->
    <item android:left="8dp" android:top="104dp" android:right="104dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="100dp"/>
            <solid android:color="#FFD700"/>
        </shape>
    </item>

    <!-- Blue button (bottom-right) -->
    <item android:left="104dp" android:top="104dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="100dp"/>
            <solid android:color="#0000FF"/>
        </shape>
    </item>

    <!-- Center circle -->
    <item android:left="85dp" android:top="85dp" android:right="85dp" android:bottom="85dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/darker_gray"/>
        </shape>
    </item>
    
    <!-- Inner center circle -->
    <item android:left="87dp" android:top="87dp" android:right="87dp" android:bottom="87dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/black"/>
        </shape>
    </item>
</layer-list> 